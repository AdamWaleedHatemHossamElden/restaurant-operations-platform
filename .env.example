MYSQL_DATABASE=restaurant_operations
MYSQL_USER=restaurant_user
MYSQL_HOST_PORT=3307
MYSQL_PASSWORD=replace_with_a_local_development_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password

# Export these when running Spring Boot locally; keep DB_PASSWORD equal to MYSQL_PASSWORD.
DB_URL=jdbc:mysql://localhost:3307/restaurant_operations?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=restaurant_user
DB_PASSWORD=replace_with_a_local_development_password
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

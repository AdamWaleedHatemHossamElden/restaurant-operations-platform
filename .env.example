MYSQL_DATABASE=restaurant_operations
MYSQL_USER=restaurant_user
MYSQL_HOST_PORT=3307
MYSQL_PASSWORD=replace_with_a_local_development_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_root_password

# Export these when running Spring Boot locally; keep DB_PASSWORD equal to MYSQL_PASSWORD.
DB_URL=jdbc:mysql://localhost:3307/restaurant_operations?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=restaurant_user
DB_PASSWORD=replace_with_a_local_development_password
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Generate a unique secret of at least 32 random bytes for HS256. Never commit the real value.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_bytes_long
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Optional and dev-profile-only. Omit both credentials to disable admin bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_local_bootstrap_password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Development Administrator

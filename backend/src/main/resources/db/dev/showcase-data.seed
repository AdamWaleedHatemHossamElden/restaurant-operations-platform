INSERT INTO recipes (menu_item_id, active, created_at, updated_at, version)
SELECT id, TRUE, DATE_SUB(@now,INTERVAL 150 DAY), @now, 0 FROM menu_items
WHERE code IN ('SP-BURRATA','SP-OCTOPUS','SP-ZUCCHINI','MN-CHICKEN','MN-SALMON','MN-KOFTA',
               'MN-GRAIN','PA-TRUFFLE','PA-PRAWN','PA-RIGATONI','PA-GNOCCHI','SA-GARDEN',
               'SA-BEET','SA-FENNEL','DE-TIRAMISU','DE-PANNA','DR-CITRUS','DR-LEMON');

INSERT INTO recipe_ingredients
    (recipe_id, inventory_item_id, quantity, display_order, created_at, updated_at)
SELECT r.id, ii.id, x.quantity, x.display_order, DATE_SUB(@now,INTERVAL 150 DAY), @now
FROM (
    SELECT 'SP-BURRATA' code,'INV-BURRATA' inv,1.000 quantity,10 display_order UNION ALL
    SELECT 'SP-BURRATA','INV-TOMATO',160.000,20 UNION ALL SELECT 'SP-BURRATA','INV-OLIVEOIL',15.000,30 UNION ALL
    SELECT 'SP-OCTOPUS','INV-OCTOPUS',170.000,10 UNION ALL SELECT 'SP-OCTOPUS','INV-POTATO',120.000,20 UNION ALL
    SELECT 'SP-ZUCCHINI','INV-ZUCCHINI',220.000,10 UNION ALL SELECT 'SP-ZUCCHINI','INV-LEMON',0.250,20 UNION ALL
    SELECT 'MN-CHICKEN','INV-CHICKEN',280.000,10 UNION ALL SELECT 'MN-CHICKEN','INV-POTATO',180.000,20 UNION ALL SELECT 'MN-CHICKEN','INV-HERBS',8.000,30 UNION ALL
    SELECT 'MN-SALMON','INV-SALMON',220.000,10 UNION ALL SELECT 'MN-SALMON','INV-POTATO',180.000,20 UNION ALL SELECT 'MN-SALMON','INV-CREAM',50.000,30 UNION ALL
    SELECT 'MN-KOFTA','INV-LAMB',240.000,10 UNION ALL SELECT 'MN-KOFTA','INV-HERBS',8.000,20 UNION ALL
    SELECT 'MN-GRAIN','INV-FARRO',150.000,10 UNION ALL SELECT 'MN-GRAIN','INV-ZUCCHINI',100.000,20 UNION ALL
    SELECT 'PA-TRUFFLE','INV-PASTA',180.000,10 UNION ALL SELECT 'PA-TRUFFLE','INV-MUSHROOM',140.000,20 UNION ALL SELECT 'PA-TRUFFLE','INV-CREAM',70.000,30 UNION ALL
    SELECT 'PA-PRAWN','INV-PASTA',180.000,10 UNION ALL SELECT 'PA-PRAWN','INV-PRAWN',160.000,20 UNION ALL SELECT 'PA-PRAWN','INV-TOMATO',120.000,30 UNION ALL
    SELECT 'PA-RIGATONI','INV-PASTA',180.000,10 UNION ALL SELECT 'PA-RIGATONI','INV-TOMATO',180.000,20 UNION ALL
    SELECT 'PA-GNOCCHI','INV-POTATO',250.000,10 UNION ALL SELECT 'PA-GNOCCHI','INV-LEMON',0.500,20 UNION ALL SELECT 'PA-GNOCCHI','INV-HERBS',6.000,30 UNION ALL
    SELECT 'SA-GARDEN','INV-GREENS',120.000,10 UNION ALL SELECT 'SA-GARDEN','INV-TOMATO',100.000,20 UNION ALL SELECT 'SA-GARDEN','INV-OLIVEOIL',20.000,30 UNION ALL
    SELECT 'SA-BEET','INV-GREENS',90.000,10 UNION ALL SELECT 'SA-BEET','INV-FETA',60.000,20 UNION ALL
    SELECT 'SA-FENNEL','INV-GREENS',90.000,10 UNION ALL SELECT 'SA-FENNEL','INV-CITRUS',1.000,20 UNION ALL
    SELECT 'DE-TIRAMISU','INV-CREAM',100.000,10 UNION ALL SELECT 'DE-TIRAMISU','INV-COFFEE',18.000,20 UNION ALL
    SELECT 'DE-PANNA','INV-CREAM',140.000,10 UNION ALL SELECT 'DE-PANNA','INV-PISTACHIO',25.000,20 UNION ALL
    SELECT 'DR-CITRUS','INV-CITRUS',2.000,10 UNION ALL SELECT 'DR-LEMON','INV-LEMON',2.000,10 UNION ALL SELECT 'DR-LEMON','INV-HERBS',3.000,20
) x
JOIN menu_items mi ON mi.code=x.code JOIN recipes r ON r.menu_item_id=mi.id JOIN inventory_items ii ON ii.code=x.inv;

INSERT INTO modifier_option_ingredients
    (modifier_option_id, inventory_item_id, quantity, display_order, created_at, updated_at)
SELECT mo.id, ii.id, x.quantity, 10, DATE_SUB(@now,INTERVAL 150 DAY), @now
FROM (
    SELECT 'Grilled Chicken' option_name,'INV-CHICKEN' inv,140.000 quantity UNION ALL
    SELECT 'Seared Salmon','INV-SALMON',120.000 UNION ALL SELECT 'Avocado','INV-AVOCADO',1.000 UNION ALL
    SELECT 'Feta','INV-FETA',50.000 UNION ALL SELECT 'Aged Parmesan','INV-PARMESAN',25.000 UNION ALL
    SELECT 'Gluten-Free Pasta','INV-GFPASTA',180.000
) x JOIN modifier_options mo ON mo.name=x.option_name JOIN inventory_items ii ON ii.code=x.inv;


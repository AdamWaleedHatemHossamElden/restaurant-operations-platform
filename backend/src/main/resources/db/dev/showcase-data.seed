INSERT INTO supplier_inventory_items
    (supplier_id,inventory_item_id,supplier_item_code,unit_cost,active,created_at,updated_at,version)
SELECT s.id, i.id, CONCAT(s.code,'-',i.code), x.cost, TRUE, DATE_SUB(@now,INTERVAL 145 DAY), @now, 0
FROM (
    SELECT 'SUP-VERDANT' supplier,'INV-TOMATO' item,0.0032 cost UNION ALL SELECT 'SUP-VERDANT','INV-GREENS',0.0085 UNION ALL
    SELECT 'SUP-VERDANT','INV-ZUCCHINI',0.0030 UNION ALL SELECT 'SUP-VERDANT','INV-MUSHROOM',0.0120 UNION ALL
    SELECT 'SUP-VERDANT','INV-POTATO',0.0018 UNION ALL SELECT 'SUP-VERDANT','INV-AVOCADO',1.1000 UNION ALL
    SELECT 'SUP-VERDANT','INV-LEMON',0.4500 UNION ALL SELECT 'SUP-VERDANT','INV-HERBS',0.0180 UNION ALL
    SELECT 'SUP-VERDANT','INV-CITRUS',0.6500 UNION ALL SELECT 'SUP-NORTHSHORE','INV-SALMON',0.0195 UNION ALL
    SELECT 'SUP-NORTHSHORE','INV-PRAWN',0.0180 UNION ALL SELECT 'SUP-NORTHSHORE','INV-OCTOPUS',0.0165 UNION ALL
    SELECT 'SUP-HEARTHLAND','INV-CHICKEN',0.0095 UNION ALL SELECT 'SUP-HEARTHLAND','INV-LAMB',0.0135 UNION ALL
    SELECT 'SUP-HEARTHLAND','INV-PASTA',0.0040 UNION ALL SELECT 'SUP-HEARTHLAND','INV-FETA',0.0100 UNION ALL
    SELECT 'SUP-HEARTHLAND','INV-PARMESAN',0.0160 UNION ALL SELECT 'SUP-HEARTHLAND','INV-CREAM',0.0028 UNION ALL
    SELECT 'SUP-MERIDIAN','INV-CITRUS',0.6200 UNION ALL SELECT 'SUP-MERIDIAN','INV-COFFEE',0.0180
) x JOIN suppliers s ON s.code=x.supplier JOIN inventory_items i ON i.code=x.item;

INSERT INTO purchase_orders
    (purchase_order_number,supplier_id,status,notes,subtotal,total,ordered_at,received_at,created_at,updated_at,version)
VALUES
    (CONCAT(@purchase_order_prefix,'001'),(SELECT id FROM suppliers WHERE code='SUP-VERDANT'),'RECEIVED','Weekly produce replenishment.',94.0000,94.0000,DATE_SUB(@now,INTERVAL 8 DAY),DATE_SUB(@now,INTERVAL 7 DAY),DATE_SUB(@now,INTERVAL 9 DAY),DATE_SUB(@now,INTERVAL 7 DAY),2),
    (CONCAT(@purchase_order_prefix,'002'),(SELECT id FROM suppliers WHERE code='SUP-NORTHSHORE'),'PARTIALLY_RECEIVED','Weekend seafood order; salmon received first.',210.0000,210.0000,DATE_SUB(@now,INTERVAL 3 DAY),NULL,DATE_SUB(@now,INTERVAL 4 DAY),DATE_SUB(@now,INTERVAL 1 DAY),2),
    (CONCAT(@purchase_order_prefix,'003'),(SELECT id FROM suppliers WHERE code='SUP-HEARTHLAND'),'ORDERED','Core pantry and protein restock.',185.0000,185.0000,DATE_SUB(@now,INTERVAL 1 DAY),NULL,DATE_SUB(@now,INTERVAL 2 DAY),DATE_SUB(@now,INTERVAL 1 DAY),1),
    (CONCAT(@purchase_order_prefix,'004'),(SELECT id FROM suppliers WHERE code='SUP-MERIDIAN'),'DRAFT','Next beverage delivery draft.',72.0000,72.0000,NULL,NULL,@now,@now,0);

INSERT INTO purchase_order_items
    (purchase_order_id,inventory_item_id,inventory_code_snapshot,inventory_name_snapshot,unit_snapshot,
     ordered_quantity,received_quantity,unit_cost_snapshot,line_total,display_order,created_at,updated_at)
SELECT po.id,i.id,i.code,i.name,i.unit,x.ordered,x.received,x.cost,x.ordered*x.cost,x.ord,po.created_at,po.updated_at
FROM (
    SELECT CONCAT(@purchase_order_prefix,'001') po,'INV-TOMATO' item,10000.000 ordered,10000.000 received,0.0032 cost,10 ord UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'001'),'INV-GREENS',4000.000,4000.000,0.0085,20 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'001'),'INV-ZUCCHINI',5000.000,5000.000,0.0030,30 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'001'),'INV-LEMON',20.000,20.000,0.4500,40 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'001'),'INV-CITRUS',6.000,6.000,0.6667,50 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'002'),'INV-SALMON',6000.000,3000.000,0.0195,10 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'002'),'INV-PRAWN',4000.000,0.000,0.0180,20 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'002'),'INV-OCTOPUS',3000.000,0.000,0.0165,30 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'003'),'INV-CHICKEN',8000.000,0.000,0.0095,10 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'003'),'INV-LAMB',5000.000,0.000,0.0135,20 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'003'),'INV-PASTA',6000.000,0.000,0.0040,30 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'003'),'INV-CREAM',6000.000,0.000,0.0028,40 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'004'),'INV-CITRUS',60.000,0.000,0.6200,10 UNION ALL
    SELECT CONCAT(@purchase_order_prefix,'004'),'INV-COFFEE',1900.000,0.000,0.0180,20
) x JOIN purchase_orders po ON po.purchase_order_number=x.po JOIN inventory_items i ON i.code=x.item;

UPDATE purchase_orders po
JOIN (
    SELECT purchase_order_id, SUM(line_total) calculated_total
    FROM purchase_order_items
    GROUP BY purchase_order_id
) totals ON totals.purchase_order_id=po.id
SET po.subtotal=totals.calculated_total, po.total=totals.calculated_total;

INSERT INTO stock_movements
    (inventory_item_id,movement_type,quantity,occurred_at,actor_user_id,reference_type,reference_id,
     source_key,reason,unit_cost,total_cost)
SELECT i.id,'ADJUSTMENT_IN',x.qty,DATE_SUB(@now,INTERVAL 30 DAY),@actor_user_id,'OPENING_BALANCE',NULL,
       CONCAT('OPENING:',i.code),'Opening showcase balance',NULL,NULL
FROM inventory_items i JOIN (
    SELECT 'INV-CHICKEN' code,6500.000 qty UNION ALL SELECT 'INV-SALMON',1200.000 UNION ALL SELECT 'INV-LAMB',5200.000 UNION ALL
    SELECT 'INV-PRAWN',4200.000 UNION ALL SELECT 'INV-PASTA',9000.000 UNION ALL SELECT 'INV-GFPASTA',1800.000 UNION ALL
    SELECT 'INV-TOMATO',5000.000 UNION ALL SELECT 'INV-GREENS',1100.000 UNION ALL SELECT 'INV-ZUCCHINI',2500.000 UNION ALL
    SELECT 'INV-MUSHROOM',2800.000 UNION ALL SELECT 'INV-POTATO',8000.000 UNION ALL SELECT 'INV-FARRO',3500.000 UNION ALL
    SELECT 'INV-BURRATA',28.000 UNION ALL SELECT 'INV-FETA',3200.000 UNION ALL SELECT 'INV-PARMESAN',2600.000 UNION ALL
    SELECT 'INV-AVOCADO',28.000 UNION ALL SELECT 'INV-OCTOPUS',2400.000 UNION ALL SELECT 'INV-CREAM',7000.000 UNION ALL
    SELECT 'INV-LEMON',42.000 UNION ALL SELECT 'INV-OLIVEOIL',6500.000 UNION ALL SELECT 'INV-HERBS',1800.000 UNION ALL
    SELECT 'INV-CITRUS',48.000 UNION ALL SELECT 'INV-COFFEE',2400.000 UNION ALL SELECT 'INV-PISTACHIO',1800.000
) x ON x.code=i.code;

INSERT INTO stock_movements
    (inventory_item_id,movement_type,quantity,occurred_at,actor_user_id,reference_type,reference_id,
     source_key,reason,unit_cost,total_cost)
SELECT poi.inventory_item_id,'RECEIPT',poi.received_quantity,po.updated_at,@actor_user_id,'PURCHASE_ORDER',po.id,
       CONCAT('PO_RECEIPT:',po.id,':',poi.id),'Showcase purchase-order receipt',poi.unit_cost_snapshot,
       poi.received_quantity*poi.unit_cost_snapshot
FROM purchase_order_items poi JOIN purchase_orders po ON po.id=poi.purchase_order_id
WHERE poi.received_quantity>0;


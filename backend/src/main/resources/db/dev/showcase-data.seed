INSERT INTO employee_availability
    (employee_id,start_at,end_at,notes,created_at,updated_at,version)
SELECT e.id,TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),x.start_time),
       TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),x.end_time),
       'Regular showcase-week availability',DATE_SUB(@now,INTERVAL 14 DAY),@now,0
FROM employees e
JOIN (SELECT 0 day_offset UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6) d
JOIN (
    SELECT 'EMP-1001' code,'10:00:00' start_time,'22:00:00' end_time UNION ALL
    SELECT 'EMP-1002','15:00:00','23:30:00' UNION ALL SELECT 'EMP-1003','16:00:00','23:59:59' UNION ALL
    SELECT 'EMP-1004','16:00:00','23:59:59' UNION ALL SELECT 'EMP-1005','16:00:00','23:59:59' UNION ALL
    SELECT 'EMP-1006','12:00:00','23:30:00' UNION ALL SELECT 'EMP-1007','12:00:00','23:30:00' UNION ALL
    SELECT 'EMP-1008','08:00:00','18:00:00' UNION ALL SELECT 'EMP-1009','16:00:00','23:59:59' UNION ALL
    SELECT 'EMP-1010','12:00:00','23:30:00'
) x ON x.code=e.employee_code;

INSERT INTO shifts
    (employee_id,operational_role,start_at,end_at,status,notes,completed_at,cancelled_at,created_at,updated_at,version)
SELECT e.id,e.default_operational_role,
       TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),x.start_time),
       TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),x.end_time),
       CASE WHEN DATE_ADD(@week_start,INTERVAL d.day_offset DAY)<@today THEN 'COMPLETED' ELSE 'SCHEDULED' END,
       x.notes,
       CASE WHEN DATE_ADD(@week_start,INTERVAL d.day_offset DAY)<@today
            THEN TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),x.end_time) ELSE NULL END,
       NULL,DATE_SUB(@now,INTERVAL 12 DAY),@now,0
FROM employees e
JOIN (SELECT 0 day_offset UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6) d
JOIN (
    SELECT 'EMP-1001' code,'12:00:00' start_time,'20:00:00' end_time,'Floor leadership' notes UNION ALL
    SELECT 'EMP-1002','16:00:00','22:30:00','Dinner host' UNION ALL
    SELECT 'EMP-1003','17:00:00','23:00:00','Main dining service' UNION ALL
    SELECT 'EMP-1006','13:00:00','21:00:00','Kitchen lead' UNION ALL
    SELECT 'EMP-1007','15:00:00','23:00:00','Hot line' UNION ALL
    SELECT 'EMP-1008','09:00:00','15:00:00','Receiving and stock control'
) x ON x.code=e.employee_code
WHERE NOT (d.day_offset=0 AND e.employee_code='EMP-1008');

INSERT INTO shifts
    (employee_id,operational_role,start_at,end_at,status,notes,completed_at,cancelled_at,created_at,updated_at,version)
SELECT e.id,e.default_operational_role,TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),'17:00:00'),
       TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),'23:30:00'),
       CASE WHEN DATE_ADD(@week_start,INTERVAL d.day_offset DAY)<@today THEN 'COMPLETED' ELSE 'SCHEDULED' END,
       'Evening service',CASE WHEN DATE_ADD(@week_start,INTERVAL d.day_offset DAY)<@today
       THEN TIMESTAMP(DATE_ADD(@week_start,INTERVAL d.day_offset DAY),'23:30:00') ELSE NULL END,
       NULL,DATE_SUB(@now,INTERVAL 10 DAY),@now,0
FROM employees e
JOIN (SELECT 4 day_offset UNION ALL SELECT 5 UNION ALL SELECT 6) d
WHERE e.employee_code IN ('EMP-1004','EMP-1005','EMP-1009','EMP-1010');


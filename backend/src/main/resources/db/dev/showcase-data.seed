INSERT INTO menu_item_modifier_groups (menu_item_id, modifier_group_id, display_order, created_at)
SELECT mi.id, mg.id, 10, DATE_SUB(@now, INTERVAL 170 DAY)
FROM menu_items mi JOIN modifier_groups mg ON mg.name='Salad Add-ons'
WHERE mi.code IN ('SA-GARDEN','SA-BEET','SA-FENNEL');
INSERT INTO menu_item_modifier_groups (menu_item_id, modifier_group_id, display_order, created_at)
SELECT mi.id, mg.id, 10, DATE_SUB(@now, INTERVAL 170 DAY)
FROM menu_items mi JOIN modifier_groups mg ON mg.name='Pasta Finish'
WHERE mi.code IN ('PA-TRUFFLE','PA-PRAWN','PA-RIGATONI','PA-GNOCCHI');
INSERT INTO menu_item_modifier_groups (menu_item_id, modifier_group_id, display_order, created_at)
SELECT mi.id, mg.id, 10, DATE_SUB(@now, INTERVAL 170 DAY)
FROM menu_items mi JOIN modifier_groups mg ON mg.name='Salmon Preparation'
WHERE mi.code='MN-SALMON';


-- Opt-in development showcase data for Cedar & Stone Kitchen.
-- This resource is executed by the development initializer and is never a Flyway location.

SET @now = UTC_TIMESTAMP(6);
SET @today = DATE(@now);
SET @week_start = DATE_SUB(@today, INTERVAL WEEKDAY(@today) DAY);
SET @reference_date = DATE_FORMAT(@today, '%Y%m%d');
SET @reference_year = DATE_FORMAT(@today, '%Y');
SET @reservation_prefix = CONCAT('RSV-', @reference_date, '-');
SET @order_prefix = CONCAT('ORD-', @reference_date, '-');
SET @payment_prefix = CONCAT('PAY-', @reference_date, '-');
SET @purchase_order_prefix = CONCAT('PO-', @reference_date, '-');
SET @pos_prefix = CONCAT('POS-', @reference_date, '-');
SET @bank_prefix = CONCAT('BANK-', @reference_date, '-');
SET @actor_user_id = (
    SELECT MIN(u.id)
    FROM users u
    JOIN user_roles ur ON ur.user_id = u.id
    JOIN roles r ON r.id = ur.role_id
    WHERE u.enabled = TRUE AND r.enabled = TRUE AND r.name = 'ADMIN'
);


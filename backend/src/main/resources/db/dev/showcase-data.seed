INSERT INTO order_items
    (order_id,menu_item_id,item_code_snapshot,item_name_snapshot,base_price_snapshot,quantity,notes,
     unit_total_snapshot,line_total,display_order,created_at,updated_at)
SELECT o.id,mi.id,mi.code,mi.name,mi.base_price,x.qty,x.notes,mi.base_price,mi.base_price*x.qty,x.ord,o.created_at,o.updated_at
FROM (
    SELECT CONCAT(@order_prefix,'001') ono,'MN-CHICKEN' code,2 qty,NULL notes,10 ord UNION ALL SELECT CONCAT(@order_prefix,'001'),'SA-GARDEN',1,NULL,20 UNION ALL
    SELECT CONCAT(@order_prefix,'002'),'MN-SALMON',2,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'002'),'PA-TRUFFLE',1,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'002'),'DE-TIRAMISU',2,NULL,30 UNION ALL
    SELECT CONCAT(@order_prefix,'003'),'PA-PRAWN',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'003'),'DR-CITRUS',2,NULL,20 UNION ALL
    SELECT CONCAT(@order_prefix,'004'),'MN-KOFTA',3,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'004'),'MN-GRAIN',2,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'004'),'SP-FETA',2,NULL,30 UNION ALL
    SELECT CONCAT(@order_prefix,'005'),'PA-RIGATONI',2,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'005'),'SA-BEET',1,NULL,20 UNION ALL
    SELECT CONCAT(@order_prefix,'006'),'SP-OCTOPUS',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'006'),'DR-LEMON',2,NULL,20 UNION ALL
    SELECT CONCAT(@order_prefix,'007'),'MN-CHICKEN',2,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'007'),'PA-GNOCCHI',1,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'007'),'DE-PANNA',2,NULL,30 UNION ALL
    SELECT CONCAT(@order_prefix,'008'),'SA-FENNEL',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'008'),'MN-SALMON',1,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'008'),'DR-CITRUS',2,NULL,30 UNION ALL
    SELECT CONCAT(@order_prefix,'009'),'MN-KOFTA',2,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'009'),'PA-PRAWN',2,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'009'),'SP-ZUCCHINI',1,NULL,30 UNION ALL
    SELECT CONCAT(@order_prefix,'010'),'MN-SALMON',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'010'),'SA-GARDEN',1,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'010'),'DE-TIRAMISU',2,NULL,30 UNION ALL
    SELECT CONCAT(@order_prefix,'011'),'PA-TRUFFLE',2,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'011'),'MN-CHICKEN',2,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'011'),'DE-CAKE',1,'Add birthday candle',30 UNION ALL
    SELECT CONCAT(@order_prefix,'012'),'MN-GRAIN',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'012'),'SP-BURRATA',1,NULL,20 UNION ALL SELECT CONCAT(@order_prefix,'012'),'DR-LEMON',2,NULL,30 UNION ALL
    SELECT CONCAT(@order_prefix,'013'),'MN-SALMON',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'013'),'SA-GARDEN',1,'No nuts',20 UNION ALL
    SELECT CONCAT(@order_prefix,'014'),'PA-PRAWN',2,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'014'),'SP-ZUCCHINI',1,NULL,20 UNION ALL
    SELECT CONCAT(@order_prefix,'015'),'MN-CHICKEN',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'015'),'DE-PANNA',1,NULL,20 UNION ALL
    SELECT CONCAT(@order_prefix,'016'),'PA-RIGATONI',1,NULL,10 UNION ALL SELECT CONCAT(@order_prefix,'016'),'DR-CITRUS',1,NULL,20
) x JOIN orders o ON o.order_number=x.ono JOIN menu_items mi ON mi.code=x.code;

INSERT INTO order_item_modifiers
    (order_item_id,modifier_group_id,modifier_option_id,group_name_snapshot,option_name_snapshot,
     price_adjustment_snapshot,display_order,created_at)
SELECT oi.id,mg.id,mo.id,mg.name,mo.name,mo.price_adjustment,10,oi.created_at
FROM (
    SELECT CONCAT(@order_prefix,'002') ono,'MN-SALMON' item,'Medium' option_name UNION ALL
    SELECT CONCAT(@order_prefix,'005'),'PA-RIGATONI','Aged Parmesan' UNION ALL
    SELECT CONCAT(@order_prefix,'008'),'MN-SALMON','Well Done' UNION ALL
    SELECT CONCAT(@order_prefix,'010'),'MN-SALMON','Medium' UNION ALL
    SELECT CONCAT(@order_prefix,'010'),'SA-GARDEN','Avocado' UNION ALL
    SELECT CONCAT(@order_prefix,'011'),'PA-TRUFFLE','Aged Parmesan' UNION ALL
    SELECT CONCAT(@order_prefix,'013'),'MN-SALMON','Medium' UNION ALL
    SELECT CONCAT(@order_prefix,'013'),'SA-GARDEN','Grilled Chicken' UNION ALL
    SELECT CONCAT(@order_prefix,'014'),'PA-PRAWN','Calabrian Chili'
) x JOIN orders o ON o.order_number=x.ono JOIN order_items oi ON oi.order_id=o.id
     JOIN menu_items mi ON mi.id=oi.menu_item_id AND mi.code=x.item
     JOIN modifier_options mo ON mo.name=x.option_name JOIN modifier_groups mg ON mg.id=mo.modifier_group_id;

UPDATE order_items oi
LEFT JOIN (SELECT order_item_id,SUM(price_adjustment_snapshot) mods FROM order_item_modifiers GROUP BY order_item_id) m
  ON m.order_item_id=oi.id
SET oi.unit_total_snapshot=oi.base_price_snapshot+COALESCE(m.mods,0),
    oi.line_total=(oi.base_price_snapshot+COALESCE(m.mods,0))*oi.quantity;
UPDATE orders o JOIN (SELECT order_id,SUM(line_total) amount FROM order_items GROUP BY order_id) x ON x.order_id=o.id
SET o.subtotal=x.amount,o.total=x.amount;

INSERT INTO order_status_history (order_id,from_status,to_status,changed_at,changed_by_user_id)
SELECT id,NULL,'OPEN',created_at,@actor_user_id FROM orders;
INSERT INTO order_status_history (order_id,from_status,to_status,changed_at,changed_by_user_id)
SELECT id,'OPEN','SUBMITTED',submitted_at,@actor_user_id FROM orders WHERE submitted_at IS NOT NULL;
INSERT INTO order_status_history (order_id,from_status,to_status,changed_at,changed_by_user_id)
SELECT id,'SUBMITTED','COMPLETED',completed_at,@actor_user_id FROM orders WHERE status='COMPLETED';

INSERT INTO kitchen_tickets
    (order_id,status,created_at,updated_at,started_at,ready_at,cancelled_at,version)
SELECT id,
       CASE order_number WHEN CONCAT(@order_prefix,'013') THEN 'PREPARING' WHEN CONCAT(@order_prefix,'014') THEN 'QUEUED'
                         WHEN CONCAT(@order_prefix,'015') THEN 'READY' ELSE 'READY' END,
       submitted_at,
       CASE WHEN status='COMPLETED' THEN DATE_SUB(completed_at,INTERVAL 25 MINUTE)
            WHEN order_number=CONCAT(@order_prefix,'013') THEN DATE_SUB(@now,INTERVAL 21 MINUTE)
            WHEN order_number=CONCAT(@order_prefix,'014') THEN submitted_at ELSE DATE_SUB(@now,INTERVAL 2 MINUTE) END,
       CASE WHEN order_number=CONCAT(@order_prefix,'014') THEN NULL ELSE DATE_ADD(submitted_at,INTERVAL 4 MINUTE) END,
       CASE WHEN status='COMPLETED' THEN DATE_SUB(completed_at,INTERVAL 25 MINUTE)
            WHEN order_number=CONCAT(@order_prefix,'015') THEN DATE_SUB(@now,INTERVAL 2 MINUTE) ELSE NULL END,
       NULL,CASE WHEN status='COMPLETED' OR order_number=CONCAT(@order_prefix,'015') THEN 2
                 WHEN order_number=CONCAT(@order_prefix,'013') THEN 1 ELSE 0 END
FROM orders WHERE status IN ('COMPLETED','SUBMITTED');

INSERT INTO kitchen_ticket_items
    (kitchen_ticket_id,order_item_id,status,created_at,updated_at,started_at,ready_at)
SELECT kt.id,oi.id,
       CASE WHEN o.status='COMPLETED' OR o.order_number=CONCAT(@order_prefix,'015') THEN 'READY'
            WHEN o.order_number=CONCAT(@order_prefix,'013') THEN 'PREPARING' ELSE 'QUEUED' END,
       kt.created_at,kt.updated_at,
       CASE WHEN o.order_number=CONCAT(@order_prefix,'014') THEN NULL ELSE DATE_ADD(kt.created_at,INTERVAL 4 MINUTE) END,
       CASE WHEN o.status='COMPLETED' THEN kt.ready_at
            WHEN o.order_number=CONCAT(@order_prefix,'015') THEN kt.ready_at ELSE NULL END
FROM kitchen_tickets kt JOIN orders o ON o.id=kt.order_id JOIN order_items oi ON oi.order_id=o.id;

INSERT INTO stock_movements
    (inventory_item_id,movement_type,quantity,occurred_at,actor_user_id,reference_type,reference_id,
     source_key,reason,unit_cost,total_cost)
SELECT ri.inventory_item_id,'USAGE',ri.quantity*oi.quantity,kti.ready_at,@actor_user_id,'KITCHEN_ITEM',kti.id,
       CONCAT('KITCHEN_ITEM:',kti.id,':INVENTORY_ITEM:',ri.inventory_item_id),'Recipe consumption',NULL,NULL
FROM kitchen_ticket_items kti JOIN order_items oi ON oi.id=kti.order_item_id
JOIN recipes r ON r.menu_item_id=oi.menu_item_id AND r.active=TRUE JOIN recipe_ingredients ri ON ri.recipe_id=r.id
WHERE kti.status='READY';

INSERT INTO stock_movements
    (inventory_item_id,movement_type,quantity,occurred_at,actor_user_id,reference_type,reference_id,
     source_key,reason,unit_cost,total_cost)
SELECT moi.inventory_item_id,'USAGE',moi.quantity*oi.quantity,kti.ready_at,@actor_user_id,'KITCHEN_ITEM',kti.id,
       CONCAT('KITCHEN_ITEM:',kti.id,':INVENTORY_ITEM:',moi.inventory_item_id),'Modifier consumption',NULL,NULL
FROM kitchen_ticket_items kti JOIN order_items oi ON oi.id=kti.order_item_id
JOIN order_item_modifiers oim ON oim.order_item_id=oi.id
JOIN modifier_option_ingredients moi ON moi.modifier_option_id=oim.modifier_option_id
WHERE kti.status='READY'
ON DUPLICATE KEY UPDATE quantity=stock_movements.quantity+VALUES(quantity);

INSERT INTO stock_movements
    (inventory_item_id,movement_type,quantity,occurred_at,actor_user_id,reference_type,reference_id,
     source_key,reason,unit_cost,total_cost)
VALUES
    ((SELECT id FROM inventory_items WHERE code='INV-SALMON'),'WASTE',1050.000,DATE_SUB(@now,INTERVAL 1 DAY),@actor_user_id,'WASTE_LOG',NULL,'WASTE:SALMON','Quality-control trim and spoilage',NULL,NULL),
    ((SELECT id FROM inventory_items WHERE code='INV-GREENS'),'WASTE',900.000,DATE_SUB(@now,INTERVAL 8 HOUR),@actor_user_id,'WASTE_LOG',NULL,'WASTE:GREENS','Wilted leaves removed during prep',NULL,NULL);

INSERT INTO payments
    (payment_number,order_id,idempotency_key,method,status,amount,currency,external_reference,
     received_at,actor_user_id,created_at)
SELECT CONCAT(@payment_prefix,LPAD(x.seq,3,'0')),o.id,CONCAT('payment-import-',@reference_date,'-',LPAD(x.seq,3,'0')),
       x.method,'SUCCEEDED',CASE WHEN x.amount_type='FULL' THEN o.total ELSE x.amount END,'EUR',x.ext,
       DATE_ADD(o.completed_at,INTERVAL x.delay_min MINUTE),@actor_user_id,DATE_ADD(o.completed_at,INTERVAL x.delay_min MINUTE)
FROM (
    SELECT 1 seq,CONCAT(@order_prefix,'001') ono,'CARD' method,'FULL' amount_type,0.00 amount,CONCAT(@pos_prefix,'001') ext,5 delay_min UNION ALL
    SELECT 2,CONCAT(@order_prefix,'002'),'CASH','FULL',0.00,NULL,7 UNION ALL
    SELECT 3,CONCAT(@order_prefix,'003'),'CARD','FULL',0.00,CONCAT(@pos_prefix,'003'),4 UNION ALL
    SELECT 4,CONCAT(@order_prefix,'004'),'BANK_TRANSFER','FULL',0.00,CONCAT(@bank_prefix,'004'),12 UNION ALL
    SELECT 6,CONCAT(@order_prefix,'006'),'CASH','FULL',0.00,NULL,3 UNION ALL
    SELECT 7,CONCAT(@order_prefix,'007'),'CARD','FIXED',40.00,CONCAT(@pos_prefix,'007'),4 UNION ALL
    SELECT 8,CONCAT(@order_prefix,'008'),'CARD','FULL',0.00,CONCAT(@pos_prefix,'008'),5 UNION ALL
    SELECT 9,CONCAT(@order_prefix,'009'),'CASH','FIXED',50.00,NULL,6 UNION ALL
    SELECT 10,CONCAT(@order_prefix,'010'),'CARD','FULL',0.00,CONCAT(@pos_prefix,'010'),5 UNION ALL
    SELECT 11,CONCAT(@order_prefix,'011'),'CARD','FIXED',50.00,CONCAT(@pos_prefix,'011'),5 UNION ALL
    SELECT 12,CONCAT(@order_prefix,'011'),'CASH','FIXED',43.00,NULL,7 UNION ALL
    SELECT 13,CONCAT(@order_prefix,'012'),'CARD','FULL',0.00,CONCAT(@pos_prefix,'013'),5
) x JOIN orders o ON o.order_number=x.ono;

INSERT INTO payment_reconciliations
    (payment_id,reconciliation_reference,reconciled_at,actor_user_id,created_at)
SELECT p.id,CONCAT('SETTLEMENT-',DATE_FORMAT(p.received_at,'%Y%m%d'),'-',LPAD(p.id,4,'0')),
       DATE_ADD(p.received_at,INTERVAL 1 DAY),@actor_user_id,DATE_ADD(p.received_at,INTERVAL 1 DAY)
FROM payments p WHERE p.method IN ('CARD','BANK_TRANSFER') AND p.received_at<DATE_SUB(@now,INTERVAL 1 DAY);

INSERT INTO invoices
    (invoice_number,order_id,order_number_snapshot,currency,subtotal,total,paid_total,issued_at,actor_user_id,created_at)
SELECT CONCAT('INV-',@reference_year,'-',RIGHT(o.order_number,3)),o.id,o.order_number,'EUR',o.subtotal,o.total,o.total,
       DATE_ADD(o.completed_at,INTERVAL 15 MINUTE),@actor_user_id,DATE_ADD(o.completed_at,INTERVAL 15 MINUTE)
FROM orders o
JOIN (SELECT order_id,SUM(amount) paid FROM payments GROUP BY order_id) p ON p.order_id=o.id AND p.paid=o.total
WHERE o.order_number IN (CONCAT(@order_prefix,'001'),CONCAT(@order_prefix,'003'),CONCAT(@order_prefix,'004'),CONCAT(@order_prefix,'006'),CONCAT(@order_prefix,'008'),CONCAT(@order_prefix,'010'),CONCAT(@order_prefix,'011'),CONCAT(@order_prefix,'012'));

INSERT INTO invoice_items
    (invoice_id,source_order_item_id,item_code,item_name,quantity,base_price,unit_total,line_total,
     display_order,created_at)
SELECT inv.id,oi.id,oi.item_code_snapshot,oi.item_name_snapshot,oi.quantity,oi.base_price_snapshot,
       oi.unit_total_snapshot,oi.line_total,oi.display_order,inv.issued_at
FROM invoices inv JOIN order_items oi ON oi.order_id=inv.order_id;
INSERT INTO invoice_item_modifiers
    (invoice_item_id,group_name,option_name,price_adjustment,display_order,created_at)
SELECT ii.id,oim.group_name_snapshot,oim.option_name_snapshot,oim.price_adjustment_snapshot,oim.display_order,inv.issued_at
FROM invoice_items ii JOIN invoices inv ON inv.id=ii.invoice_id
JOIN order_item_modifiers oim ON oim.order_item_id=ii.source_order_item_id;

